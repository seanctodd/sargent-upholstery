# static.cloudflareinsights.com is Cloudflare Web Analytics' beacon, injected at
# the edge. It was enabled on the zone but blocked by this policy, so it had
# never collected anything and logged a console error on every page load --
# which Lighthouse's Best Practices audit counts against the site.
#
# It needs BOTH entries. Cloudflare's docs describe proxied sites reporting to
# <domain>/cdn-cgi/rum, which 'self' would cover -- but the beacon actually
# POSTs to the absolute host https://cloudflareinsights.com/cdn-cgi/rum, so
# connect-src needs it too. Allowing only the script host loads the beacon but
# silently blocks every report, which still fails the console-errors audit.
#
# script-src keeps 'unsafe-inline' for Cloudflare, not for this site. Cloudflare
# injects a JavaScript Detections bootstrap into every HTML response at the edge
# (window.__CF$cv$params -> /cdn-cgi/challenge-platform/scripts/jsd/), and it is
# inline. Under Bot Fight Mode that injection cannot be turned off. Removing
# 'unsafe-inline' blocks it, which silently disables bot detection and logs a CSP
# violation on every page load -- verified live on 2026-07-31.
#
# The supported alternative is a per-request nonce, which Cloudflare will add to
# its own scripts; a static Pages site cannot generate one without a Function.
#
# The site's own JavaScript is deliberately NOT inline -- gallery.js and main.js
# are both fingerprinted assets under themes/sargent/assets/js/. Keep it that
# way: it is better for caching and it is what makes tests/*.test.js able to
# exercise the real files.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; media-src 'self' https://media.sargentupholstery.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube.com https://www.google.com https://app.shopmonkey.cloud; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Cache-Control is set by exactly ONE rule per path below. Cloudflare Pages
# merges every matching rule and joins duplicate headers with a comma, so two
# rules matching the same file would emit a malformed Cache-Control.

# Fingerprinted by Hugo's asset pipeline -- the filename carries a content hash
# (style.min.<hash>.css, main.min.<hash>.js, *_hu_<hash>.webp), so the URL
# changes whenever the bytes do. Safe to cache forever and never revalidate.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/instagram/*
  Cache-Control: public, max-age=31536000, immutable

# Logos, fingerprinted from themes/sargent/assets/img/. They live under /img/
# rather than /images/ so this rule can mark them immutable without also
# matching the hand-made hero variants, which are not fingerprinted. Two rules
# matching one file would emit a comma-joined Cache-Control.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Copied verbatim from static/ at FIXED urls -- the filename does not change
# when the content does. `immutable` here told browsers not to revalidate even
# on an explicit reload, which pinned a broken logo.svg for up to a year. Cache
# for a week, then let the ETag revalidate (a cheap 304 when unchanged).
#
# Anything that must be updatable on demand belongs in the pipeline instead:
# move it under themes/sargent/assets/ and pipe it through `fingerprint`.
# Hero variants, hand-generated and served at fixed names. A week, because
# swapping a hero keeps its filename and returning visitors must pick it up.
/images/*
  Cache-Control: public, max-age=604800

# The font is also a fixed name, but it is a pinned Work Sans subset that has no
# reason to change. A year, still WITHOUT immutable, so a reload can recover if
# it ever does.
/fonts/*
  Cache-Control: public, max-age=31536000

# No rule for HTML on purpose. These globs match the REQUEST PATH, and Hugo
# serves clean URLs (/gallery/, not /gallery/index.html), so a `/*.html` rule
# only ever matches a literal .html request and never real traffic. Cloudflare
# Pages already serves HTML as `public, max-age=0, must-revalidate`, which is
# the revalidate-every-time behaviour we want. Do not re-add `/*.html`; to
# change HTML caching you would have to set Cache-Control on the `/*` block,
# which would also apply to the immutable asset rules above.
