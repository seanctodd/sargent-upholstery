/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://www.googletagmanager.com https://*.google-analytics.com; media-src 'self' https://media.sargentupholstery.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://www.youtube.com https://www.google.com https://app.shopmonkey.cloud; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Cache-Control is set by exactly ONE rule per path below. Cloudflare Pages
# merges every matching rule and joins duplicate headers with a comma, so two
# rules matching the same file would emit a malformed Cache-Control.

# Fingerprinted by Hugo's asset pipeline -- the filename carries a content hash
# (style.min.<hash>.css, main.min.<hash>.js, *_hu_<hash>.webp), so the URL
# changes whenever the bytes do. Safe to cache forever and never revalidate.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/instagram/*
  Cache-Control: public, max-age=31536000, immutable

# Copied verbatim from static/ at FIXED urls -- the filename does not change
# when the content does. `immutable` here told browsers not to revalidate even
# on an explicit reload, which pinned a broken logo.svg for up to a year. Cache
# for a week, then let the ETag revalidate (a cheap 304 when unchanged).
#
# Anything that must be updatable on demand belongs in the pipeline instead:
# move it under themes/sargent/assets/ and pipe it through `fingerprint`.
/images/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=604800

# No rule for HTML on purpose. These globs match the REQUEST PATH, and Hugo
# serves clean URLs (/gallery/, not /gallery/index.html), so a `/*.html` rule
# only ever matches a literal .html request and never real traffic. Cloudflare
# Pages already serves HTML as `public, max-age=0, must-revalidate`, which is
# the revalidate-every-time behaviour we want. Do not re-add `/*.html`; to
# change HTML caching you would have to set Cache-Control on the `/*` block,
# which would also apply to the immutable asset rules above.
